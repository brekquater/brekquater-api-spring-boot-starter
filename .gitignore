# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven
target/
# Left behind by "./mvnw versions:set" when backups are not turned off
*.versionsBackup

# IDEs
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# Eclipse and IntelliJ build output
.factorypath
bin/
out/

# Documentation site output, and a Python environment for previewing it (see CONTRIBUTING.md)
/site/
/_site/
.venv/
venv/
__pycache__/

# Operating systems
.DS_Store
Thumbs.db

# Test tool caches
.jqwik-database

# Local Claude Code settings
.claude/settings.local.json
.claude/launch.json

# Secrets and signing keys must never be committed
.env
.env.*
*.gpg
*.asc
*.pem
*.key
*.p12
*.jks

# Planning documents kept on the maintainer's machine only
/CLAUDE.md
/docs/PRD.md
/docs/DESIGN.md
/RELEASE-GUIDE.md
