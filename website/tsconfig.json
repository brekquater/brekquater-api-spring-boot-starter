{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // TypeScript 7 removed baseUrl, which @docusaurus/tsconfig still sets, so unset it and declare the @site/* alias
    // here, where it resolves from this folder. Remove both lines once Docusaurus's tsconfig drops baseUrl.
    "baseUrl": null,
    "paths": {"@site/*": ["./*"]}
  },
  "exclude": [".docusaurus", "build"]
}
