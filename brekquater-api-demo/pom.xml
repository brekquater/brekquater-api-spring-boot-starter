<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.brekquater</groupId>
    <artifactId>brekquater-api-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>

  <artifactId>brekquater-api-demo</artifactId>

  <name>Brekquater API Demo</name>
  <description>Sample application for the Brekquater API Spring Boot Starter. It doubles as the integration test.</description>

  <properties>
    <!-- The demo is a sample, not a library, so it is never published. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <central.skipPublishing>true</central.skipPublishing>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.brekquater</groupId>
      <artifactId>brekquater-api-spring-boot-starter</artifactId>
    </dependency>
    <!-- The bad API exposes an Actuator endpoint in its document (BQ-SEC-011). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
      <!-- The demo tests mock nothing, and Mockito's agent makes Java 21+ print a dynamic-agent warning. -->
      <exclusions>
        <exclusion>
          <groupId>org.mockito</groupId>
          <artifactId>mockito-core</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.mockito</groupId>
          <artifactId>mockito-junit-jupiter</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Writes target/site/jacoco/jacoco.xml, so the good profile shows the demo's own coverage after a build. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <!-- Without Spring Boot's parent POM the executable jar is not built unless this goal is bound here. -->
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
