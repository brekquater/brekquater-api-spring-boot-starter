  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "LegacyProduct": {
        "type": "object",
        "discriminator": {
          "propertyName": "kind"
        },
        "properties": {
          "stock": {
            "type": "integer",
            "format": "int32",
            "example": "many"
          },
          "added": {
            "type": "integer",
            "format": "date-time"
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "enum": [
              "1",
              "2"
            ]
          },
          "colour": {
            "type": "string",
            "enum": [
              "red",
              "red"
            ]
          },
          "status": {
            "type": "string",
            "default": "paused",
            "enum": [
              "on",
              "off"
            ]
          },
          "url": {
            "type": "string"
          },
          "URL": {
            "type": "string"
          },
          "extra": {}
        }
      },
      "OrderQuery": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "pattern": "[A-Z]+"
          }
        }
      },
      "LegacyError": {
        "type": "object",
        "properties": {
          "errorMessage": {
            "type": "string"
          },
          "error_code": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "Link": {
        "type": "object",
        "properties": {
          "href": {
            "type": "string"
          },
          "templated": {
            "type": "boolean"
          }
        }
      },
      "LegacyAccount": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "securitySchemes": {
      "legacyToken": {
        "type": "http",
        "scheme": "JWT"
      },
      "legacyLogin": {
        "type": "oauth2",
        "flows": {
          "password": {
            "tokenUrl": "https://auth.example.com/token",
            "scopes": {}
          }
        }
      },
      "legacyBasic": {
        "type": "http",
        "scheme": "basic"
      },
      "legacyKerberos": {
        "type": "http",
        "scheme": "negotiate"
      },
      "legacyKey": {
        "type": "apiKey",
        "name": "api_key",
        "in": "query"
      },
      "legacySso": {
        "type": "oauth2",
        "flows": {
          "implicit": {
            "authorizationUrl": "http://sso.example.com/authorize",
            "scopes": {
              "accounts:read": "Read accounts"
            }
          }
        }
      }
    }
  }
