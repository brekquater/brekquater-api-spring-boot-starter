<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.brekquater</groupId>
    <artifactId>brekquater-api-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>brekquater-api-spring-boot-starter</artifactId>

  <name>Brekquater API Spring Boot Starter</name>
  <description>Add this one dependency to see API design warnings and a maturity score inside Swagger UI.</description>

  <!-- A starter bundles dependencies and contains no code. -->
  <dependencies>
    <dependency>
      <groupId>com.brekquater</groupId>
      <artifactId>brekquater-api-spring-boot</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>
  </dependencies>

  <profiles>
    <!-- Maven Central requires sources and Javadoc jars even for a module without code, so these hold a README. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <executions>
              <execution>
                <id>empty-sources</id>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <classifier>sources</classifier>
                  <classesDirectory>${project.basedir}/src/release</classesDirectory>
                </configuration>
              </execution>
              <execution>
                <id>empty-javadoc</id>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <classifier>javadoc</classifier>
                  <classesDirectory>${project.basedir}/src/release</classesDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
